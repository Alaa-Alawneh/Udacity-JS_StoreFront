{
  "name": "storefront_backend",
  "version": "0.1.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "watch": "tsc-watch --esModuleInterop src/server.ts --outDir ./dist --onSuccess \"node ./dist/server.js\"",
    "start": "node dist/server.js",
    "build": "tsc",
    "jasmine": "jasmine",
    "test": "cross-env ENV=test db-migrate up --config database.js --env test && tsc && cross-env ENV=test jasmine && db-migrate reset --config database.js --env test",
    "migrate": "db-migrate up --config database.js",
    "migrate:reset": "db-migrate reset --config database.js"
  },
  "author": "Udacity",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^4.17.9",
    "bcrypt": "5.0.1",
    "body-parser": "^1.19.0",
    "db-migrate": "0.11.13",
    "db-migrate-pg": "1.2.2",
    "dotenv": "8.2.0",
    "express": "^4.17.1",
    "jsonwebtoken": "8.5.1",
    "pg": "8.7.3",
    "typescript": "4.9.5"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.0",
    "@types/jasmine": "3.6.11",
    "@types/jsonwebtoken": "8.5.9",
    "@types/node": "16.18.126",
    "@types/pg": "8.6.6",
    "@types/supertest": "2.0.12",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jasmine": "3.6.4",
    "supertest": "6.1.6",
    "ts-node": "9.1.1",
    "tsc-watch": "^4.2.9"
  }
}
